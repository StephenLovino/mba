# GoHighLevel API Configuration
# Get these values from your GoHighLevel account

# Your GHL API Token (from Settings > API)
GHL_TOKEN=your_ghl_api_token_here

# Your GHL Location ID (from Settings > Business Profile)
GHL_LOCATION_ID=your_ghl_location_id_here

# GHL API Base URL (optional, defaults to https://services.leadconnectorhq.com)
GHL_API_BASE=https://services.leadconnectorhq.com

# Xendit API Configuration (for payment processing)
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. Never commit .env.local to git (it's in .gitignore)
# 4. Use 'vercel dev' to run locally with these variables

